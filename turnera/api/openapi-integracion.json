  "info" : {
    "description" : "Lo que un programa de fuera puede leer de un centro y la reserva de huecos de su agenda. Se entra con OAuth 2.0 client credentials: POST /api/v1/integration/token con el client_id y el client_secret que da el centro, y el token en 'Authorization: Bearer <access_token>'. Guía completa: https://devel.es/turnera/api",
    "title" : "Turnera: API de integración",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/integration/accounting-draft" : {
      "get" : {
        "operationId" : "accountingDraft",
        "parameters" : [ {
          "in" : "query",
          "name" : "from",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountingDraftResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Bad Request"
          }
        },
        "summary" : "Daily VAT summary of what was settled, as a draft to review with the accountant",
        "tags" : [ "Integration" ]
      }
    },
    "/api/v1/integration/availability" : {
      "get" : {
        "operationId" : "availability",
        "parameters" : [ {
          "in" : "query",
          "name" : "serviceId",
          "required" : true,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "day",
          "required" : true,
          "schema" : {
            "format" : "date",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Availability"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Free start times of a day for a service that is booked online",
        "tags" : [ "Integration" ]
      }
    },
    "/api/v1/integration/bookings" : {
      "post" : {
        "operationId" : "book",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/IntegrationBookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Booking"
                }
              }
            },
            "description" : "That reference was already booked: the same appointment"
          },
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Booking"
                }
              }
            },
            "description" : "Booked"
          },
          "400" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Booking"
                }
              }
            },
            "description" : "A field is missing, or the customer has no phone nor email"
          },
          "409" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Booking"
                }
              }
            },
            "description" : "BOOKING_SLOT_TAKEN, BOOKING_TOO_FAR_AHEAD or BOOKING_MINIMUM_NOTICE, in the 'code' of the problem detail"
          }
        },
        "summary" : "Book a free slot for a customer brought by the integration",
        "tags" : [ "Integration" ]
      }
    },
